# The systemd socket owns the tailnet listener. A standalone sshd using this
# file would bind loopback only.
Port 2222
AddressFamily inet
ListenAddress 127.0.0.1
HostKey /etc/ssh/portfolio-deploy-host-ed25519
PidFile /run/portfolio-deploy-sshd.pid
AllowUsers portfolio-deploy
AuthorizedKeysFile /etc/ssh/portfolio-deploy.keys
AuthenticationMethods publickey
PubkeyAuthentication yes
UsePAM yes
PasswordAuthentication no
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin no
DisableForwarding yes
PermitTunnel no
PermitTTY no
PermitUserEnvironment no
PermitUserRC no
MaxSessions 1
LoginGraceTime 30
ForceCommand /usr/local/libexec/portfolio-public-activate
