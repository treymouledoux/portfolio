[Unit]
Description=Portfolio web server (axum, port 6050)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=trey
WorkingDirectory=/home/trey/portfolio-deployment/current
ExecStart=/home/trey/portfolio-deployment/current/portfolio-serve
Environment=PORTFOLIO_BIND=127.0.0.1:6050
Environment=PORTFOLIO_DATA_DIR=/home/trey/portfolio-deployment/data
Environment=PORTFOLIO_TRUST_CLOUDFLARE=true
UMask=0077
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
