[Unit]
Description=Cloudflare Tunnel for portfolio
After=network-online.target portfolio.service
Wants=network-online.target

[Service]
Type=simple
User=trey
# Requires the tunnel credentials to already exist on the Pi:
#   ~/.cloudflared/cert.pem, the tunnel's credentials JSON, and config.yml
# --config is explicit so systemd loads the right file regardless of HOME.
ExecStart=/usr/bin/cloudflared --config /home/trey/.cloudflared/config.yml tunnel run portfolio-tunnel

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
