[Unit]
Description=Private dashboard socket for the HTTPS gateway
Requires=portfolio-dashboard-guard.service
After=portfolio-dashboard-guard.service

[Socket]
ListenStream=/run/portfolio-dashboard-peer/dashboard.sock
Service=portfolio-dashboard.service
# systemd creates the parent directory as root:root, so set its group here;
# only root and the caddy group may enter it.
ExecStartPre=+/usr/bin/install -d -o root -g caddy -m 0750 /run/portfolio-dashboard-peer
FileDescriptorName=peer
DirectoryMode=0750
SocketUser=root
SocketGroup=caddy
SocketMode=0660
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
