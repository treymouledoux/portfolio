[Unit]
Description=Private status HTTP socket for Tailscale Serve
Requires=portfolio-dashboard-guard.service
After=portfolio-dashboard-guard.service

[Socket]
ListenStream=/run/portfolio-dashboard/app.sock
FileDescriptorName=dashboard
DirectoryMode=0700
SocketUser=root
SocketGroup=root
SocketMode=0600
RemoveOnStop=yes

[Install]
WantedBy=sockets.target
