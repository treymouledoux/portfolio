[Unit]
Description=Host agent for the private dashboard
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/libexec/portfolio-dashboard-agent
Environment=DASHBOARD_AGENT_SHELL_USER=trey
Type=simple
User=root
UMask=0077
# NoNewPrivileges is deliberately not set here: with it, the kernel refuses the
# setuid that starts the human account's shell, so the terminal could not open.
# The shell is that account, not root, and any sudo it tries still needs the
# account's own password.
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
PrivateDevices=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
LockPersonality=yes
# The shell is a real login shell for a human, so the agent does not enter a
# home sandbox: /home must stay writable for the account it runs.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
