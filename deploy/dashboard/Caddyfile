{
	admin off
	auto_https off
	servers {
		protocols h1 h2
		strict_sni_host on
	}
}

# Restore an allowlisted field only when its saved value is nonempty. An
# empty Range header has different HTTP semantics from no Range header.
(restore_public_header) {
	@has_{args[0]} vars_regexp {http.vars.public_{args[0]}} .
	request_header @has_{args[0]} {args[0]} {http.vars.public_{args[0]}}
}

(public_upstream) {
	# The origin and Host are fixed. Only explicitly listed request fields
	# reach the public application. It cannot use this connection to Serve.
	transport http {
		dial_timeout 3s
		response_header_timeout 15s
		compression off
	}
	header_up -X-Forwarded-*
	header_up Host treymouledoux.me
	header_down -Set-Cookie
	header_down -Alt-Svc
}

https://treymouledoux.me {
	# Replace both documentation addresses with this private node's tail IPs.
	bind 192.0.2.1 2001:db8::1
	tls /etc/caddy/tls/apex-fullchain.pem /etc/caddy/tls/apex-key.pem

	# The dashboard lives on its own private hostname. Nothing of it is rendered
	# or redirected from the apex, which serves only the public site.
	@public_read method GET HEAD
	@contact {
		method POST
		path /api/contact
	}
	route {
		# Snapshot the public fields, clear the original headers, and restore
		# only fields the client actually sent before calling the public app.
		vars {
			public_Accept {http.request.header.Accept}
			public_Accept-Encoding {http.request.header.Accept-Encoding}
			public_Content-Type {http.request.header.Content-Type}
			public_Range {http.request.header.Range}
			public_If-Range {http.request.header.If-Range}
			public_If-Modified-Since {http.request.header.If-Modified-Since}
			public_If-None-Match {http.request.header.If-None-Match}
		}
		request_header -*
		import restore_public_header Accept
		import restore_public_header Accept-Encoding
		import restore_public_header Content-Type
		import restore_public_header Range
		import restore_public_header If-Range
		import restore_public_header If-Modified-Since
		import restore_public_header If-None-Match
		handle @contact {
			request_body {
				max_size 64KiB
			}
			reverse_proxy 127.0.0.1:6050 {
				import public_upstream
				# Matches portfolio-serve's existing loopback proxy contract.
				header_up CF-Connecting-IP {http.request.remote.host}
			}
		}
		handle @public_read {
			reverse_proxy 127.0.0.1:6050 {
				import public_upstream
			}
		}
		handle {
			header Cache-Control no-store
			respond 405
		}
	}
	handle_errors {
		header Cache-Control no-store
		respond "Request unavailable." {err.status_code}
	}
}

# The whole dashboard on one origin, reachable only from the tailnet. Caddy
# terminates TLS and forwards the direct peer address; it cannot reach
# tailscaled or the app's Serve socket, so identity is decided downstream.
https://dashboard.treymouledoux.me {
  bind 192.0.2.1 2001:db8::1
  tls /etc/caddy/dashboard-tls/dashboard-fullchain.pem /etc/caddy/dashboard-tls/dashboard-key.pem
  # Which peer asked for the dashboard, and what it got back.
  log


	reverse_proxy unix//run/portfolio-dashboard-peer/dashboard.sock {
		# Replace anything the client sent: the app trusts only this socket.
		header_up -Tailscale-User-Login
		header_up -Tailscale-User-Name
		header_up -Tailscale-User-Profile-Pic
		header_up X-Portfolio-Peer {http.request.remote.host}
	}
}
