# Replace both bind directives with the same literal Pi tailnet IPs. Omit
# an unused family from both. Literal addresses fail to bind if unavailable.
# Replace the view's /32 and /128 with individually approved client IPs.
# CoreDNS reads the direct DNS packet source; shared resolvers obscure it.
treymouledoux.me:53 {
    bind 192.0.2.1 2001:db8::1
    # Record which client asked and which view answered it.
    log
    view dashboard_viewers {
        expr incidr(client_ip(), '192.0.2.10/32') || incidr(client_ip(), '2001:db8::10/128')
    }
    template IN A {
        match ^treymouledoux[.]me[.]$
        answer "{{ .Name }} 30 IN A 192.0.2.1"
        fallthrough
    }
    # This example advertises private IPv4 only. Suppress public IPv6 and
    # service binding hints for this apex while preserving other DNS records.
    template IN AAAA {
        match ^treymouledoux[.]me[.]$
        rcode NOERROR
        fallthrough
    }
    template IN HTTPS {
        match ^treymouledoux[.]me[.]$
        rcode NOERROR
        fallthrough
    }
    template IN SVCB {
        match ^treymouledoux[.]me[.]$
        rcode NOERROR
        fallthrough
    }
    template IN A {
        match ^dashboard[.]treymouledoux[.]me[.]$
        answer "{{ .Name }} 300 IN A 192.0.2.1"
        fallthrough
    }
    template IN AAAA {
        match ^dashboard[.]treymouledoux[.]me[.]$
        answer "{{ .Name }} 300 IN AAAA 2001:db8::1"
        fallthrough
    }
    # The public record for the dashboard name carries Cloudflare address hints
    # and an ECH key, which Apple platforms follow and reach the public edge
    # instead of this node. Suppress it for the same reason as the apex.
    template IN HTTPS {
        match ^dashboard[.]treymouledoux[.]me[.]$
        rcode NOERROR
        fallthrough
    }
    template IN SVCB {
        match ^dashboard[.]treymouledoux[.]me[.]$
        rcode NOERROR
        fallthrough
    }
    forward . /etc/portfolio-dns/public-resolv.conf
}

# Other direct tailnet clients get ordinary public DNS for this zone.
treymouledoux.me:53 {
    bind 192.0.2.1 2001:db8::1
    log
    forward . /etc/portfolio-dns/public-resolv.conf
}
