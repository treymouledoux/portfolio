[Unit]
Description=Private portfolio HTTPS gateway
BindsTo=sys-subsystem-net-devices-tailscale0.device
Requires=portfolio-dashboard-guard.service
After=portfolio-dashboard-guard.service sys-subsystem-net-devices-tailscale0.device tailscaled.service portfolio.service
Wants=portfolio.service

[Service]
Type=notify
NotifyAccess=main
User=caddy
Group=caddy
# Check the kernel's installed full-pilot table. The status-only and first-run
# stages omit this chain. Only this fixed query runs with elevated privileges.
ExecStartPre=+/usr/sbin/nft list chain inet portfolio_private_guard apex_http01
ExecStartPre=/usr/local/libexec/portfolio-caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
ExecStart=/usr/local/libexec/portfolio-caddy run --config /etc/caddy/Caddyfile --adapter caddyfile
Environment=XDG_DATA_HOME=/var/lib/portfolio-gateway XDG_CONFIG_HOME=/var/lib/portfolio-gateway
StateDirectory=portfolio-gateway
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
SocketBindDeny=any
SocketBindAllow=ipv4:tcp:443
SocketBindAllow=ipv6:tcp:443
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
InaccessiblePaths=-/run/tailscale -/run/portfolio-dashboard -/etc/portfolio-dashboard -/etc/portfolio-public -/etc/letsencrypt -/var/lib/tailscale -/var/lib/portfolio-public -/srv/portfolio/public -/etc/ssh -/etc/credstore
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
PrivateDevices=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
LimitCORE=0
RestrictNamespaces=yes
RestrictSUIDSGID=yes
UMask=0077
Restart=on-failure
RestartSec=5

[Install]
WantedBy=sys-subsystem-net-devices-tailscale0.device
