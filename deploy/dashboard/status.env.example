# Store the filled copy in /etc/portfolio-dashboard/status.env (root:root 0600).
DASHBOARD_VIEWERS=owner@example.invalid
DASHBOARD_JETKVM_IP=192.0.2.9
DASHBOARD_JETKVM_PORT=REPLACE_WITH_CONFIRMED_NUMERIC_PORT
# Optional: one tailnet IPv4 address, so the dashboard can echo Muse directly.
# Leave it unset and Muse reports presence only, with no ping line.
# DASHBOARD_MUSE_IP=192.0.2.10
# Optional values shown on the private dashboard for native terminal access.
# Prefer the Pi's verified MagicDNS FQDN. Name the account authorized by SSH policy.
# DASHBOARD_PI_MACHINE=example-pi.example-tailnet.ts.net
# DASHBOARD_PI_SSH_USER=example-operator
# Optional exact Tailscale logins allowed to read contact messages. Each must also be a viewer.
# DASHBOARD_INBOX_READERS=owner@example.invalid
# Optional owner-only removal confirmation on the independent Serve origin.
# DASHBOARD_INBOX_ADMINS=owner@example.invalid
# DASHBOARD_ADMIN_ORIGIN=https://example-pi.example-tailnet.ts.net:8443
# ... or the gateway hostname, for example https://dashboard.example.invalid
